# bulk water

units           metal
boundary        p p p
atom_style      atomic

neighbor        2.0 bin
neigh_modify    every 10 delay 0 check no

read_data	10PAN_train11.2_nvt_300K.data.txt

# load the deepmd plugin
plugin load libdeepmd_lmp.so

pair_style	deepmd ../CHNOLi_train18_r8_s2.pb
pair_coeff  * *	

#minimize        0.0 1.0e-8 1000 100000
#velocity        all create 300.0 23456789

compute 1 all gyration

fix             1 all nvt temp 300.0 300.0 10
timestep        0.0001
thermo_style    custom step pe ke etotal temp press vol c_1
thermo          100
dump		1 all custom 100 10mer-cyc_300K_train18_Rg.dump id type x y z vx vy vz

run             8000000
